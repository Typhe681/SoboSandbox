[gd_resource type="Resource" load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
script/source = "extends Resource

const SRC := 'user://sobosandbox/'
const DST := 'res://game_mode/game_modes/sandbox/'
const SCRIPTS := ['scene_sandbox.gd', 'sandbox.gd']
const RESOURCES := ['scene_sandbox.tscn']

var _f: FileAccess

func _init() -> void:
	_f = FileAccess.open('user://sandbox_boot_probe.txt', FileAccess.WRITE)
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null:
		_log('no tree')
		return
	var keep: Array = []
	var loaded: Dictionary = {}
	for f: String in SCRIPTS:
		if not FileAccess.file_exists(SRC + f):
			_log(f + ' missing')
			return
		var gd := GDScript.new()
		gd.source_code = FileAccess.get_file_as_string(SRC + f)
		gd.take_over_path(DST + f)
		loaded[f] = gd
		keep.append(gd)
	for f: String in SCRIPTS:
		var err: int = loaded[f].reload()
		_log(f + ' err=' + str(err))
		if err != OK:
			return
	for f: String in RESOURCES:
		if not FileAccess.file_exists(SRC + f):
			_log(f + ' missing')
			return
		var res: Resource = ResourceLoader.load(SRC + f, '', ResourceLoader.CACHE_MODE_IGNORE)
		if res == null:
			_log(f + ' failed to load')
			return
		res.take_over_path(DST + f)
		keep.append(res)
		_log(f + ' registered')
	tree.root.set_meta('sandbox_keep', keep)
	var node: Node = loaded['sandbox.gd'].new()
	node.name = 'SoboSandbox'
	tree.root.add_child.call_deferred(node)
	_log('sandbox added')

func _log(msg: String) -> void:
	if _f:
		_f.store_line(msg)
		_f.flush()
"

[resource]
script = SubResource("1")
